# ───────── Avícola Don Ramón — variables de entorno ─────────
# Copiá este archivo a ".env" y completá los valores.

# Base de datos PostgreSQL (Prisma).
# En desarrollo local podés dejarlo vacío: la app funciona con datos de ejemplo.
DATABASE_URL=""

# API key que tu bot de n8n debe enviar en cada request:
#   Authorization: Bearer <API_KEY>
# Generá una larga y aleatoria, por ejemplo: openssl rand -hex 32
# Si se deja vacío, la API queda ABIERTA (solo para desarrollo).
API_KEY=""

# ───────── Login de clientes/admin (OTP por WhatsApp) ─────────

# Clave para firmar las cookies de sesión. OBLIGATORIA en producción (mín. 16 chars).
# Generala con: openssl rand -hex 32
SESSION_SECRET=""

# Webhook de n8n que envía el código OTP por WhatsApp.
# Recibe un POST { phone, code, message }. Si se deja vacío, en desarrollo el
# código se imprime por consola (no se envía nada). En producción es obligatorio.
OTP_WHATSAPP_WEBHOOK_URL=""

# (Provisorio) Si todavía no tenés el webhook de n8n, poné "true" para que en
# producción el código OTP se imprima en los logs de la aplicación en vez de
# enviarse por WhatsApp. Leelo con: pm2 logs avicola-don-ramon | grep OTP
# ⚠️ Desactivalo ("false" o borrar) cuando el webhook esté andando.
OTP_LOG_FALLBACK=""

# (Provisorio) Si está en "true", cada OTP también se imprime en consola aunque
# se envíe por WhatsApp. Desactivarlo en producción cuando ya esté validado.
OTP_LOG_CODE=""

# (Opcional) Si lo definís, la web manda "Authorization: Bearer <valor>" al webhook
# para que n8n valide que la petición viene de la web.
OTP_WEBHOOK_SECRET=""

# ───────── Panel /admin (usuario y contraseña únicos) ─────────

# Credenciales del panel de administración (/admin/login).
# En desarrollo, si se dejan vacías, valen admin/admin.
# ADMIN_PASSWORD es OBLIGATORIA en producción.
ADMIN_USER="admin"
ADMIN_PASSWORD=""

# Teléfonos con acceso al panel /admin, separados por coma (en cualquier formato:
# se normalizan a solo dígitos). Quien inicie sesión con uno de estos números
# queda como administrador.
ADMIN_PHONES="+54 9 11 5555 5555"

# ───────── Pagos online (Mercado Pago Checkout Pro) ─────────

# Access token de Mercado Pago. TEST-... para pruebas, APP_USR-... en producción.
# Se saca de https://www.mercadopago.com.ar/developers → Tus integraciones →
# Credenciales. Si se deja vacío, el botón de Mercado Pago devuelve error 503.
MP_ACCESS_TOKEN=""

# Firma secreta de Webhooks de Mercado Pago (Tus integraciones > Webhooks).
# Si se define, las notificaciones con firma inválida se rechazan con 401.
MP_WEBHOOK_SECRET=""

# Demo/pruebas: si es "1"/"true", el botón de Mercado Pago NO va al checkout
# real: crea el pedido, lo marca pagado (en_preparacion) y vuelve a la pantalla
# de resultado. Útil para recorrer todo el flujo (pedido → reparto → entregado)
# sin pagar. Dejar vacío/"0" para el checkout real.
CHECKOUT_FAKE_PAYMENT=""

# URL pública del sitio (sin barra final), ej. https://avicoladonramon.consultoriadigital.io
# Se usa para las back_urls del checkout y para que Mercado Pago pueda llamar
# al webhook /api/checkout/mercadopago/webhook. En localhost puede quedar vacía.
NEXT_PUBLIC_BASE_URL=""

# ───────── Avisos de pedidos a n8n (WhatsApp de seguimiento) ─────────

# Webhook de n8n que recibe los eventos del pedido. La web hace un POST con
# { event, at, order } cada vez que un pedido cambia de estado:
#   pedido_confirmado (pago aprobado) · pedido_en_camino (salió del local)
#   pedido_entregado (código validado) · pedido_cancelado
# Ver docs/n8n-pedidos.md para el flujo completo sugerido.
N8N_ORDER_WEBHOOK_URL=""

# (Opcional) Webhook exclusivo para el mensaje enviado al cerrar el lote:
# "Tu pedido está saliendo de la sucursal". Si queda vacío, usa el webhook
# general de pedidos de arriba.
N8N_ORDER_DISPATCH_WEBHOOK_URL=""

# Webhook exclusivo para pedido_entregado. Si queda vacío, usa esta misma URL
# de producción como valor predeterminado.
N8N_ORDER_DELIVERED_WEBHOOK_URL="https://n8n.srv1224751.hstgr.cloud/webhook/pedido-entregado"

# (Opcional) Si lo definís, la web manda "Authorization: Bearer <valor>" al
# webhook de pedidos para que n8n valide que la petición viene de la web.
N8N_ORDER_WEBHOOK_SECRET=""

# Webhook que recibe la reasignación hecha desde Reparto o Entregas. Si se deja
# vacío, se usa el webhook de producción configurado para Polleriano.
N8N_DELIVERY_CANCEL_WEBHOOK_URL="https://n8n.srv1224751.hstgr.cloud/webhook/pollerianoentregado"
N8N_DELIVERY_CANCEL_WEBHOOK_SECRET=""

# ───────── Reparto (repartidor) ─────────
# Ya no usa token: cada repartidor entra a /reparto con su usuario y contraseña
# (se crean en /admin/equipo con rol "repartidor") y ve solo sus entregas.

# ───────── Asistente de IA (botón flotante de la tienda) ─────────

# API key de DeepSeek (https://platform.deepseek.com/api_keys).
# Le da contexto del catálogo real al asistente que responde en la burbuja de
# chat de la tienda. Si se deja vacío, el chat responde "no disponible" y el
# botón de WhatsApp sigue funcionando igual.
DEEPSEEK_API_KEY=""

# ───────── Solo para docker-compose ─────────
POSTGRES_USER=polleria
POSTGRES_PASSWORD=
POSTGRES_DB=polleria
WEB_PORT=3000
